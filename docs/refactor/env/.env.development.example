# AIHub · .env.development.example
# ================================
# 开发公共配置（git tracked）
# 仅 NODE_ENV=development 时加载
# 完整说明见 docs/refactor/infra/envLayering.md

# === Cache / Queue ===
REDIS_URL=redis://localhost:6379

# === Cloudflare R2 (本地 MinIO 兼容) ===
R2_BUCKET=aihub-dev
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000/aihub-dev

# === Cron Jobs ===
ENABLE_LOCAL_CRON=1                      # 启用本地 cron（否则仅手动 trigger）

# === OpenTelemetry ===
ENABLE_OTEL=0
OTEL_EXPORTER_OTLP_ENDPOINT=
