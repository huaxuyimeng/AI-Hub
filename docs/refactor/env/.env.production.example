# AIHub · .env.production.example
# ================================
# 生产覆盖（git ignored）
# 部署时由 CI / 运维手动注入
# 完整说明见 docs/refactor/infra/envLayering.md

NODE_ENV=production
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASS@HOST:5432/aihub
NEXTAUTH_URL=https://aihub.example.com

# === 性能 / 监控 ===
LOG_LEVEL=warn
LOG_FORMAT=json
ENABLE_OTEL=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# === Cron 调度（Vercel Cron 或 k8s CronJob）===
CRON_SECRET=                             # 必须与 .env.secret 一致
