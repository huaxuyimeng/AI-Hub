# AIHub · .env.secret.example
# ================================
# 私密变量（git ignored）
# 仅部署时手动注入，绝不能 commit
# 完整说明见 docs/refactor/infra/envLayering.md
#
# 生成示例：
#   openssl rand -base64 32    # NEXTAUTH_SECRET / CRON_SECRET
#   openssl rand -hex 32       # 同上（不同编码）

# === AI Providers（按需启用，不启用的留空） ===
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# === Auth ===
NEXTAUTH_SECRET=

# === Cloudflare R2 ===
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=

# === Upstash Redis（生产） ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Alerting（Slack） ===
SLACK_WEBHOOK_URL=

# === Cron Security ===
CRON_SECRET=
