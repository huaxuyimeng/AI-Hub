# AIHub · .env.base.example
# ================================
# 公共默认值（git tracked）
# 所有环境都会加载；最低优先级
# 完整说明见 docs/refactor/infra/envLayering.md

# === Runtime ===
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
PORT=3000

# === Database ===
DATABASE_PROVIDER=sqlite                # sqlite | postgresql
DATABASE_URL=file:./dev.db

# === AI Provider Routing ===
# deepseek-v4-flash 是默认模型；其他 provider 通过 key 启用
AIHUB_DEFAULT_MODEL=deepseek-v4-flash
AIHUB_AI_MOCK=1                          # dev 模式无 key 时走 mock
LITELLM_BASE_URL=                        # 生产 LiteLLM 代理地址（可选）

# === Logging ===
LOG_LEVEL=info                           # trace | debug | info | warn | error
LOG_FORMAT=json                          # json | pretty
