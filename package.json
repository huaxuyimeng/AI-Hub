{
  "name": "aihub",
  "version": "0.1.0",
  "private": true,
  "description": "AIHub 毕业设计 MVP 骨架 —— Next.js 14 + Prisma 6 + tRPC + LiteLLM",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:models": "tsx prisma/seed-models.ts",
    "backfill:models": "tsx scripts/backfill-model-snapshots.ts",
    "test:rankings": "tsx src/lib/rankings/algorithm.test.ts",
    "test:usage": "tsx src/lib/usage.test.ts",
    "test:slides": "tsx src/lib/slide-engine/slide-engine.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install chromium --with-deps",
    "slide:lint": "tsx src/lib/slide-engine/cli.ts lint",
    "slide:snapshot": "tsx src/lib/slide-engine/cli.ts snapshot",
    "slide:render": "tsx src/lib/slide-engine/cli.ts render-pptx",
    "slide:test": "tsx src/lib/slide-engine/cli.ts test",
    "cron:cleanup": "tsx src/scripts/cleanup-orphan-files.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@auth/prisma-adapter": "^2.7.0",
    "@aws-sdk/client-s3": "^3.654.0",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/sdk-node": "^0.53.0",
    "@prisma/client": "^6.0.0",
    "@tabler/icons-react": "^3.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@trpc/client": "^11.0.0",
    "@trpc/next": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@upstash/redis": "^1.34.0",
    "bcryptjs": "^2.4.3",
    "geist": "^1.3.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.10",
    "openai": "^4.65.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "superjson": "^2.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.47",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
