# ===== 数据库 =====
# 来源：数据库设计.md §二 技术选型 + 部署运维.md §5.2
DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
SHADOW_DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/shadow"

# ===== Auth =====
# 来源：批次 A 必修项
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<openssl rand -base64 32>"

# ===== 本地开发默认账号（仅开发/演示模式使用，生产环境自动跳过）=====
# 未配置时不自动填入；配置格式：email,password
# 例：DEV_DEFAULT_ACCOUNT="admin@aihub.local,admin123"
DEV_DEFAULT_ACCOUNT=""

# GitHub OAuth（https://github.com/settings/developers）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===== AI Provider（多 Provider 直连，详见 docs/实施记录/41-P0施工方案_2026.09.02.md）=====
# 来源：AI集成.md §三 LiteLLM 路由 + 批次 B8 修复
# 默认 key 池（用户未配置自己的 key 时使用这些作为兜底）
DEEPSEEK_API_KEY="sk-..."           # DeepSeek 系列（deepseek-v4-flash 等）
ZHIPU_API_KEY="sk-..."              # 智谱 GLM 系列（glm-4-7-flash 等）
ANTHROPIC_API_KEY="sk-ant-..."      # Anthropic 系列（claude-sonnet-4-5 等）
# 以下为可选：用户可在设置页配置自己的 key，优先级高于环境变量
KIMI_API_KEY="sk-..."              # 月之暗面 Kimi 系列

# ===== LiteLLM Proxy（AI 新闻意图搜索 / 关键词抽取 / 模型排行都依赖）=====
# 默认 localhost:4000；生产环境必须改为真实地址，否则意图搜索会静默失败
# 例：LITELLM_BASE_URL="https://litellm.your-domain.com/v1"
LITELLM_BASE_URL="http://localhost:4000/v1"
LITELLM_API_KEY="anything"  # 若 proxy 要求鉴权，改为真实 key

# ===== 文件存储 =====
# 来源：部署运维.md §11.1 R2 配置 + Fix-5 extractR2Key
CLOUDFLARE_R2_ACCOUNT_ID="..."
CLOUDFLARE_R2_ACCESS_KEY_ID="..."
CLOUDFLARE_R2_SECRET_ACCESS_KEY="..."
CLOUDFLARE_R2_BUCKET="aihub-files"
CLOUDFLARE_R2_PUBLIC_URL="https://files.aihub.example.com"

# ===== 缓存 =====
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# ===== Cron 鉴权（批次 B13 验证）=====
CRON_SECRET="<openssl rand -hex 32>"

# ===== B 站爬虫 =====
# BILI_SESSDATA：登录 B 站后从 cookie 中获取（必须有，绕过 WBI 风控 -799）
#   获取方式：登录 bilibili.com → F12 → Application → Cookies → SESSDATA
#   过期时间约 1 个月，快过期时需更新
BILI_SESSDATA=""
# RSSHUB_BASE_URL：B站 RSS 兜底源（API 全失败时自动启用）
#   生产环境建议自部署 RSSHub（https://github.com/DIYgod/RSSHub），稳定性更高
#   留空则默认用 rsshub.app（官方免费实例，可能限流/不稳定）
#   自部署例：https://rsshub.your-domain.com
RSSHUB_BASE_URL=""

# ===== 孤儿文件保留期（批次 C28 校验）=====
# 默认 7 天；与批次 B13 一致；cleanup.ts 读取
ORPHAN_RETENTION_DAYS="7"

# ===== 监控 =====
SENTRY_DSN="https://...@sentry.io/..."
# 可选。未配置时告警只打 JSON 日志
SLACK_WEBHOOK_URL=""
