# ===== 数据库 =====
# 来源：数据库设计.md §二 技术选型 + 部署运维.md §5.2
DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
SHADOW_DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/shadow"

# ===== Auth =====
# 来源：批次 A 必修项
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<openssl rand -base64 32>"

# GitHub OAuth（https://github.com/settings/developers）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===== AI Provider（二选一，默认 DeepSeek）=====
# 来源：AI集成.md §三 LiteLLM 路由 + 批次 B8 修复
DEEPSEEK_API_KEY="sk-..."
KIMI_API_KEY="sk-..."  # K2.7-code 版本（2026-08-31 起 K2 已停用）
ANTHROPIC_API_KEY="sk-ant-..."

# ===== 文件存储 =====
# 来源：部署运维.md §11.1 R2 配置 + Fix-5 extractR2Key
CLOUDFLARE_R2_ACCOUNT_ID="..."
CLOUDFLARE_R2_ACCESS_KEY_ID="..."
CLOUDFLARE_R2_SECRET_ACCESS_KEY="..."
CLOUDFLARE_R2_BUCKET="aihub-files"
CLOUDFLARE_R2_PUBLIC_URL="https://files.aihub.example.com"

# ===== 缓存 =====
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."

# ===== Cron 鉴权（批次 B13 验证）=====
CRON_SECRET="<openssl rand -hex 32>"

# ===== 孤儿文件保留期（批次 C28 校验）=====
# 默认 7 天；与批次 B13 一致；cleanup.ts 读取
ORPHAN_RETENTION_DAYS="7"

# ===== 监控 =====
SENTRY_DSN="https://...@sentry.io/..."
